      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        240,
        0
      ],
      "parameters": {
        "command": "={{ \"python3 ./pipeline.py publish --form \" + JSON.stringify({episode:$json[\"Bölüm kodu\"], title:$json[\"YouTube başlığı\"], description:$json[\"YouTube açıklaması\"], visibility:$json[\"Görünürlük\"]}).base64Encode() }}",
        "executeOnce": true
      }
    },
    {
