      "typeVersion": 1,
      "position": [
        720,
        0
      ],
      "parameters": {
        "resource": "video",
        "operation": "upload",
        "regionCode": "TR",
        "categoryId": "27",
        "binaryProperty": "data",
        "title": "={{ JSON.parse($(\"Yükleme dosyasını doğrula\").first().json.stdout).title }}",
        "options": {
          "description": "={{ JSON.parse($(\"Yükleme dosyasını doğrula\").first().json.stdout).description }}",
          "privacyStatus": "={{ JSON.parse($(\"Yükleme dosyasını doğrula\").first().json.stdout).visibility }}",
          "selfDeclaredMadeForKids": true,
          "defaultLanguage": "tr",
          "notifySubscribers": false
        }
      }
    },
