                  },
                  {
                    "option": "public"
                  }
                ]
              }
            }
          ]
        },
        "responseMode": "onReceived",
        "options": {
          "path": "ecmel-youtube",
          "buttonLabel": "YouTube’a yükle",
          "appendAttribution": false
        }
      },
      "webhookId": "67a980f7-d0a2-598f-b8d8-905ddc8c89f6"
